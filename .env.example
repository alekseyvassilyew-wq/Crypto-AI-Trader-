# Telegram bot credentials
BOT_TOKEN=
ADMIN_ID=0
TELEGRAM_GROUP_CHAT_ID=0
TOPIC_GENERAL_ID=0
TOPIC_TRADES_ID=0
TOPIC_PORTFOLIO_ID=0
TOPIC_PROFIT_ID=0
TOPIC_ERRORS_ID=0

# Kraken private credentials are optional and used only for read-only balance checks.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# PAPER-only trading configuration. Live mode is rejected by the application.
TRADING_MODE=PAPER
DATABASE_PATH=./crypto_ai_trader.sqlite3
PAPER_START_EUR=20
MAX_TRADE_EUR=5
MAX_DAILY_LOSS_EUR=2
MAX_OPEN_POSITIONS=2
MAX_SPREAD_BPS=25
MIN_24H_TURNOVER_EUR=10000
PAPER_FEE_RATE=0.0026
SCAN_INTERVAL_SECONDS=60
STOP_LOSS_PERCENT=2
TAKE_PROFIT_PERCENT=4
TRAILING_STOP_PERCENT=1.5
TRADE_QUOTE_CURRENCY=EUR
MAX_CANDLE_PAIRS=20
ENABLE_MULTI_TIMEFRAME=true
RISK_PER_TRADE_PERCENT=0.5
ML_AUTO_RESEARCH_MARKETS=3
